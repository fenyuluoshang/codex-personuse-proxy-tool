diff --git a/src-tauri/src/personal_proxy.rs b/src-tauri/src/personal_proxy.rs
new file mode 100644
index 0000000..102308d
--- /dev/null
+++ b/src-tauri/src/personal_proxy.rs
@@ -0,0 +1,228 @@
+//! Local integration boundary. No frontend argument can supply a command, path,
+//! URL, or credential. This module never touches Codex or proxy configuration.
+
+use serde::{Deserialize, Serialize};
+use std::{
+    net::IpAddr,
+    path::PathBuf,
+    process::{Child, Command, Stdio},
+    sync::Mutex,
+    time::Duration,
+};
+
+/// Owns only the gateway process started by this CC Switch instance.
+/// No process lookup or name-based termination is used.
+#[derive(Default)]
+pub struct GatewayProcessState(pub Mutex<Option<Child>>);
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PersonalProxyStatus {
+    gateway: &'static str,
+    ready: bool,
+    upstream_host: Option<String>,
+    helper_available: bool,
+    helper_supported: bool,
+    gateway_available: bool,
+    gateway_owned: bool,
+}
+
+#[derive(Deserialize)]
+struct GatewayStatus {
+    ready: bool,
+    upstream_host: String,
+}
+
+fn helper_path() -> Result<PathBuf, &'static str> {
+    let exe = std::env::current_exe().map_err(|_| "executable_path_unavailable")?;
+    let dir = exe.parent().ok_or("executable_path_unavailable")?;
+    Ok(dir.join("helpers").join("ChatGPTProxyManager.exe"))
+}
+
+fn gateway_binary_path() -> Result<PathBuf, &'static str> {
+    let exe = std::env::current_exe().map_err(|_| "executable_path_unavailable")?;
+    let dir = exe.parent().ok_or("executable_path_unavailable")?;
+    let name = if cfg!(target_os = "windows") {
+        "codex-gateway.exe"
+    } else {
+        "codex-gateway"
+    };
+    Ok(dir.join("helpers").join(name))
+}
+
+fn gateway_config_path() -> Result<PathBuf, &'static str> {
+    let exe = std::env::current_exe().map_err(|_| "executable_path_unavailable")?;
+    let dir = exe.parent().ok_or("executable_path_unavailable")?;
+    Ok(dir.join("gateway.json"))
+}
+
+fn gateway_owned_running(state: &GatewayProcessState) -> bool {
+    let Ok(mut process) = state.0.lock() else { return false; };
+    let Some(child) = process.as_mut() else { return false; };
+    match child.try_wait() {
+        Ok(None) => true,
+        Ok(Some(_)) | Err(_) => {
+            *process = None;
+            false
+        }
+    }
+}
+
+fn gateway_url() -> Result<url::Url, &'static str> {
+    let endpoint = std::env::var("CODEX_PROXY_GATEWAY_URL")
+        .unwrap_or_else(|_| "http://127.0.0.1:8787".to_string());
+    validate_gateway_url(&endpoint)
+}
+
+fn validate_gateway_url(endpoint: &str) -> Result<url::Url, &'static str> {
+    let mut parsed = url::Url::parse(endpoint).map_err(|_| "invalid_config")?;
+    let loopback = parsed.host_str().and_then(|host| host.trim_matches(['[', ']']).parse::<IpAddr>().ok())
+        .is_some_and(|ip| ip.is_loopback());
+    if parsed.scheme() != "http" || !loopback || !parsed.username().is_empty()
+        || parsed.password().is_some() || parsed.query().is_some() || parsed.fragment().is_some()
+        || parsed.path() != "/" {
+        return Err("invalid_config");
+    }
+    parsed.set_path("/admin/status");
+    Ok(parsed)
+}
+
+#[tauri::command]
+pub async fn personal_proxy_status(
+    process: tauri::State<'_, GatewayProcessState>,
+) -> Result<PersonalProxyStatus, String> {
+    let gateway_available = gateway_binary_path().is_ok_and(|path| path.is_file())
+        && gateway_config_path().is_ok_and(|path| path.is_file());
+    let gateway_owned = gateway_owned_running(&process);
+    let mut result = PersonalProxyStatus {
+        gateway: "unreachable", ready: false, upstream_host: None,
+        helper_available: cfg!(target_os = "windows") && helper_path().is_ok_and(|path| path.is_file()),
+        helper_supported: cfg!(target_os = "windows"),
+        gateway_available,
+        gateway_owned,
+    };
+    let endpoint = match gateway_url() {
+        Ok(endpoint) => endpoint,
+        Err(_) => { result.gateway = "invalid_config"; return Ok(result); }
+    };
+    // Credentials are read by the Rust backend only and never returned to JS.
+    let token = match std::env::var("CODEX_GATEWAY_ADMIN_TOKEN") {
+        Ok(token) if !token.trim().is_empty() => token,
+        _ => { result.gateway = "unauthorized"; return Ok(result); }
+    };
+    let client = reqwest::Client::builder().no_proxy()
+        .redirect(reqwest::redirect::Policy::none()).timeout(Duration::from_secs(3))
+        .build().map_err(|_| "local_client_unavailable".to_string())?;
+    let mut response = match client.get(endpoint).bearer_auth(token).send().await {
+        Ok(response) => response,
+        Err(_) => return Ok(result),
+    };
+    if response.status() == reqwest::StatusCode::UNAUTHORIZED {
+        result.gateway = "unauthorized";
+        return Ok(result);
+    }
+    if !response.status().is_success() || response.content_length().is_some_and(|len| len > 16384) {
+        result.gateway = "invalid_response";
+        return Ok(result);
+    }
+    let mut body = Vec::new();
+    loop {
+        match response.chunk().await {
+            Ok(Some(chunk)) if body.len() + chunk.len() <= 16384 => body.extend_from_slice(&chunk),
+            Ok(None) => break,
+            _ => { result.gateway = "invalid_response"; return Ok(result); }
+        }
+    }
+    match serde_json::from_slice::<GatewayStatus>(&body) {
+        Ok(status) if status.upstream_host.len() <= 255 && !status.upstream_host.contains(['@', '/', '\\', '?', '#']) => {
+            result.ready = status.ready;
+            result.gateway = if status.ready { "ready" } else { "stopped" };
+            result.upstream_host = Some(status.upstream_host);
+        }
+        _ => result.gateway = "invalid_response",
+    }
+    Ok(result)
+}
+
+#[tauri::command]
+pub fn personal_proxy_start_gateway(
+    process: tauri::State<'_, GatewayProcessState>,
+) -> Result<(), String> {
+    let binary = gateway_binary_path().map_err(str::to_string)?;
+    let config = gateway_config_path().map_err(str::to_string)?;
+    if !binary.is_file() {
+        return Err("gateway_not_found".to_string());
+    }
+    if !config.is_file() {
+        return Err("gateway_config_not_found".to_string());
+    }
+    let mut slot = process.0.lock().map_err(|_| "gateway_state_unavailable")?;
+    if let Some(existing) = slot.as_mut() {
+        match existing.try_wait() {
+            Ok(None) => return Ok(()),
+            Ok(Some(_)) | Err(_) => *slot = None,
+        }
+    }
+    let child = Command::new(binary)
+        .arg("-config")
+        .arg(config)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|_| "gateway_start_failed".to_string())?;
+    *slot = Some(child);
+    Ok(())
+}
+
+#[tauri::command]
+pub fn personal_proxy_stop_gateway(
+    process: tauri::State<'_, GatewayProcessState>,
+) -> Result<(), String> {
+    stop_owned_gateway(process.inner()).map_err(str::to_string)
+}
+
+/// Stop only the child process recorded by this application instance.
+/// Existing gateway processes discovered by port/name are intentionally left alone.
+pub fn stop_owned_gateway(process: &GatewayProcessState) -> Result<(), &'static str> {
+    let mut slot = process.0.lock().map_err(|_| "gateway_state_unavailable".to_string())?;
+    let Some(mut child) = slot.take() else { return Ok(()); };
+    if child.try_wait().map_err(|_| "gateway_stop_failed")?.is_some() {
+        return Ok(());
+    }
+    child.kill().map_err(|_| "gateway_stop_failed")?;
+    let _ = child.wait();
+    Ok(())
+}
+
+#[tauri::command]
+pub fn personal_proxy_open_helper() -> Result<(), String> {
+    #[cfg(target_os = "windows")]
+    {
+        let path = helper_path().map_err(str::to_string)?;
+        if !path.is_file() { return Err("helper_not_found".to_string()); }
+        // Open the original visible WPF window, without --enable/--launch flags.
+        let mut child = std::process::Command::new(path).spawn()
+            .map_err(|_| "helper_start_failed".to_string())?;
+        // Reap only this child handle; never enumerate or terminate Codex processes.
+        std::thread::spawn(move || { let _ = child.wait(); });
+        Ok(())
+    }
+    #[cfg(not(target_os = "windows"))]
+    Err("helper_unsupported_platform".to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::validate_gateway_url;
+
+    #[test]
+    fn gateway_endpoint_is_loopback_only() {
+        assert!(validate_gateway_url("http://127.0.0.1:8787").is_ok());
+        assert!(validate_gateway_url("http://[::1]:8787").is_ok());
+        for address in ["https://example.com", "http://localhost:8787", "http://127.0.0.1:8787/path",
+            "http://user:secret@127.0.0.1:8787", "http://127.0.0.1:8787?token=x"] {
+            assert!(validate_gateway_url(address).is_err(), "{address}");
+        }
+    }
+}
