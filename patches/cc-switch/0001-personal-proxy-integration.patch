+++ b/tests/components/PersonalProxyPage.test.tsx
@@ -0,0 +1,88 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { PersonalProxyPage } from "@/components/personal-proxy/PersonalProxyPage";
+
+const invoke = vi.fn();
+vi.mock("@tauri-apps/api/core", () => ({
+  invoke: (...args: unknown[]) => invoke(...args),
+}));
+
+describe("PersonalProxyPage", () => {
+  beforeEach(() => {
+    invoke.mockReset();
+  });
+
+  it("shows verified service status without requesting credentials in JS", async () => {
+    invoke.mockResolvedValue({
+      gateway: "ready",
+      ready: true,
+      upstreamHost: "test.example",
+      helperAvailable: true,
+      helperSupported: true,
+      gatewayAvailable: true,
+      gatewayOwned: false,
+    });
+    render(<PersonalProxyPage />);
+    expect(await screen.findByText("网关已就绪")).toBeInTheDocument();
+    expect(screen.getByText("已配置上游：test.example")).toBeInTheDocument();
+    expect(invoke).toHaveBeenCalledWith("personal_proxy_status");
+    fireEvent.click(screen.getByRole("button", { name: "打开代理启动器" }));
+    await waitFor(() =>
+      expect(invoke).toHaveBeenCalledWith("personal_proxy_open_helper"),
+    );
+    expect(await screen.findByRole("alert")).toHaveTextContent(
+      "已打开代理启动器窗口",
+    );
+  });
+
+  it("shows an actionable unavailable state and disables a missing helper", async () => {
+    invoke.mockResolvedValue({
+      gateway: "unreachable",
+      ready: false,
+      upstreamHost: null,
+      helperAvailable: false,
+      helperSupported: true,
+      gatewayAvailable: false,
+      gatewayOwned: false,
+    });
+    render(<PersonalProxyPage />);
+    expect(
+      await screen.findByText("无法连接本地网关，请确认网关已启动"),
+    ).toBeInTheDocument();
+    expect(
+      screen.getByRole("button", { name: "打开代理启动器" }),
+    ).toBeDisabled();
+  });
+
+  it("starts and stops only the app-owned gateway", async () => {
+    let owned = false;
+    const status = () => ({
+      gateway: "stopped",
+      ready: false,
+      upstreamHost: "test.example",
+      helperAvailable: false,
+      helperSupported: true,
+      gatewayAvailable: true,
+      gatewayOwned: owned,
+    });
+    invoke.mockImplementation(async (command: string) => {
+      if (command === "personal_proxy_status") return status();
+      if (command === "personal_proxy_start_gateway") owned = true;
+      if (command === "personal_proxy_stop_gateway") owned = false;
+      return undefined;
+    });
+    render(<PersonalProxyPage />);
+    expect(await screen.findByText("网关尚未就绪")).toBeInTheDocument();
+    fireEvent.click(screen.getByRole("button", { name: "启动网关" }));
+    await waitFor(() =>
+      expect(invoke).toHaveBeenCalledWith("personal_proxy_start_gateway"),
+    );
+    await waitFor(() =>
+      expect(screen.getByRole("button", { name: "停止网关" })).toBeEnabled(),
+    );
+    fireEvent.click(screen.getByRole("button", { name: "停止网关" }));
+    await waitFor(() =>
+      expect(invoke).toHaveBeenCalledWith("personal_proxy_stop_gateway"),
+    );
+  });
+});
