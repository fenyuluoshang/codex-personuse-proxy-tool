index 0000000..0ccd978
--- /dev/null
+++ b/src/components/personal-proxy/PersonalProxyPage.tsx
@@ -0,0 +1,185 @@
+import { useEffect, useState } from "react";
+import { invoke } from "@tauri-apps/api/core";
+import {
+  RefreshCw,
+  ExternalLink,
+  ShieldCheck,
+  Play,
+  Square,
+} from "lucide-react";
+import { Button } from "@/components/ui/button";
+
+export interface PersonalProxyStatus {
+  gateway: string;
+  ready: boolean;
+  upstreamHost: string | null;
+  helperAvailable: boolean;
+  helperSupported: boolean;
+  gatewayAvailable: boolean;
+  gatewayOwned: boolean;
+}
+
+const STATUS_LABELS: Record<string, string> = {
+  ready: "网关已就绪",
+  stopped: "网关尚未就绪",
+  unreachable: "无法连接本地网关，请确认网关已启动",
+  unauthorized: "本机管理令牌未配置或不匹配，请检查启动环境",
+  invalid_config: "网关地址配置无效，仅支持本机回环 HTTP 地址",
+  invalid_response: "网关返回了不兼容的状态响应",
+};
+
+export function PersonalProxyPage() {
+  const [status, setStatus] = useState<PersonalProxyStatus | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState("");
+
+  const refresh = async () => {
+    setBusy(true);
+    setMessage("");
+    try {
+      setStatus(await invoke<PersonalProxyStatus>("personal_proxy_status"));
+    } catch {
+      setMessage("无法读取本机状态，请重试或检查应用构建版本。");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  useEffect(() => {
+    void refresh();
+  }, []);
+
+  const openHelper = async () => {
+    setBusy(true);
+    setMessage("");
+    try {
+      await invoke("personal_proxy_open_helper");
+      setMessage("已打开代理启动器窗口。请在该窗口检查设置后操作。");
+    } catch {
+      setMessage(
+        "无法打开代理启动器，请检查发布包中 helpers 目录的程序是否存在。",
+      );
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const setGatewayRunning = async (running: boolean) => {
+    setBusy(true);
+    setMessage("");
+    try {
+      await invoke(
+        running
+          ? "personal_proxy_start_gateway"
+          : "personal_proxy_stop_gateway",
+      );
+      await refresh();
+      setMessage(
+        running
+          ? "已启动本应用管理的本地网关。"
+          : "已停止本应用管理的本地网关。",
+      );
+    } catch {
+      setMessage(
+        running
+          ? "无法启动网关，请检查发布包中的 gateway.json 和网关程序。"
+          : "无法停止本应用管理的网关。",
+      );
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <section
+      id="main-content"
+      className="flex min-h-0 flex-1 flex-col overflow-y-auto p-6"
+    >
+      <div className="mb-6 flex items-center justify-between gap-3">
+        <div>
+          <h1 className="text-xl font-semibold text-fg-1">个人代理工具</h1>
+          <p className="mt-1 text-sm text-fg-2">
+            查看本地网关，打开原代理启动器。模型线路仍在 Codex 供应商页面选择。
+          </p>
+        </div>
+        <Button
+          variant="outline"
+          onClick={() => void refresh()}
+          disabled={busy}
+        >
+          <RefreshCw className="mr-2 h-4 w-4" />
+          刷新状态
+        </Button>
+      </div>
+      <div className="grid gap-4 md:grid-cols-2">
+        <div className="rounded-lg border border-border bg-surface p-5">
+          <h2 className="mb-3 flex items-center gap-2 font-medium">
+            <ShieldCheck className="h-4 w-4" />
+            本地模型网关
+          </h2>
+          <p role="status" className="text-sm text-fg-1">
+            {status
+              ? (STATUS_LABELS[status.gateway] ?? "未知状态")
+              : "正在读取状态…"}
+          </p>
+          {status?.upstreamHost && (
+            <p className="mt-2 break-all text-sm text-fg-2">
+              已配置上游：{status.upstreamHost}
+            </p>
+          )}
+          <p className="mt-3 text-sm text-fg-2">
+            网关就绪仅表示本机服务可用，不代表上游请求或官方账号功能已验证。
+          </p>
+          <div className="mt-4 flex flex-wrap gap-2">
+            <Button
+              variant="outline"
+              onClick={() => void setGatewayRunning(true)}
+              disabled={
+                busy || !status?.gatewayAvailable || status.gatewayOwned
+              }
+            >
+              <Play className="mr-2 h-4 w-4" />
+              启动网关
+            </Button>
+            <Button
+              variant="outline"
+              onClick={() => void setGatewayRunning(false)}
+              disabled={busy || !status?.gatewayOwned}
+            >
+              <Square className="mr-2 h-4 w-4" />
+              停止网关
+            </Button>
+          </div>
+          <p className="mt-2 text-xs text-fg-2">
+            {status?.gatewayOwned
+              ? "当前网关由本应用启动并可由此停止。"
+              : "未由本应用启动的同名进程不会被停止。"}
+          </p>
+        </div>
+        <div className="rounded-lg border border-border bg-surface p-5">
+          <h2 className="mb-3 font-medium">Windows 代理启动器</h2>
+          <p className="mb-4 text-sm text-fg-2">
+            {status?.helperSupported === false
+              ? "当前系统不支持 Windows 启动器。"
+              : status?.helperAvailable
+                ? "已找到代理启动器，点击后打开独立原窗口。"
+                : "尚未找到代理启动器，请检查发布包。"}
+          </p>
+          <Button
+            variant="outline"
+            onClick={() => void openHelper()}
+            disabled={busy || !status?.helperAvailable}
+          >
+            <ExternalLink className="mr-2 h-4 w-4" />
+            打开代理启动器
+          </Button>
+        </div>
+      </div>
+      {message && (
+        <p role="alert" className="mt-4 text-sm text-fg-2">
+          {message}
+        </p>
+      )}
+    </section>
+  );
+}
