+/// Inject the gateway client token only at the Rust boundary for a numeric
+/// loopback HTTP target. The token is read from the process environment and is
+/// never stored in ProviderMeta, the provider database, or JavaScript.
+fn apply_local_gateway_token(
+    headers: &mut http::HeaderMap,
+    url: &url::Url,
+    is_copilot: bool,
+) {
+    if is_copilot || url.scheme() != "http" {
+        return;
+    }
+    let Some(host) = url.host_str() else { return; };
+    let Ok(ip) = host.parse::<std::net::IpAddr>() else { return; };
+    if !ip.is_loopback() {
+        return;
+    }
+    let Ok(token) = std::env::var("CODEX_GATEWAY_CLIENT_TOKEN") else {
+        return;
+    };
+    let token = token.trim();
+    if token.is_empty() {
+        return;
+    }
+    let value = format!("Bearer {token}");
+    if let Ok(value) = http::HeaderValue::from_str(&value) {
+        headers.insert(
+            http::HeaderName::from_static("x-codex-gateway-token"),
+            value,
+        );
+    }
+}
